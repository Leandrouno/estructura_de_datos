{
  "name": "Estructura de Datos - C++",
  "image": "mcr.microsoft.com/devcontainers/cpp:1-ubuntu-24.04",
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools", "ms-vscode.cpptools-extension-pack"],
      "settings": {
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 1500,
        "C_Cpp.default.cppStandard": "c++17"
      }
    }
  },
  "postStartCommand": "bash scripts/start-autosync.sh"
}
